    }
}

export function switchAdminTab(tabName) {
    AppStore.activeAdminTab = tabName;
    const container = document.getElementById('admin-panel-content');
    container.innerHTML = '';

    const btns = ['siswa', 'poin', 'restitusi', 'absen', 'kas', 'tugas', 'rekap_nilai', 'identitas', 'rapor'];
    btns.forEach(b => {
        const el = document.getElementById(`tab-btn-${b}`);
        if (el) el.className = "p-2 bg-white border-2 border-sky-200 rounded-2xl flex flex-col items-center justify-center gap-1 shadow-sm transition active:scale-95";
    });

    const activeBtn = document.getElementById(`tab-btn-${tabName}`);
    if (activeBtn) {
        activeBtn.className = "p-2 bg-sky-100 border-2 border-sky-400 rounded-2xl flex flex-col items-center justify-center gap-1 shadow-sm transition scale-105 font-black";
    }

    if (tabName === 'siswa') renderTabSiswa(container);
    else if (tabName === 'poin') renderTabPoin(container);
    else if (tabName === 'restitusi') renderTabRestitusi(container);
    else if (tabName === 'absen') renderTabAbsen(container);
    else if (tabName === 'kas') renderTabKas(container);
    else if (tabName === 'tugas') renderTabTugas(container);
    else if (tabName === 'rekap_nilai') renderTabRekapNilai(container);
    else if (tabName === 'identitas') renderTabIdentitas(container);
    else if (tabName === 'rapor') renderTabRapor(container);
}

