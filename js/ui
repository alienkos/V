            const isExpanded = AppStore.expandedTaskId === t.id;

            let totalScoreVal = 0;
            let gradedCount = 0;
            taskSubms.forEach(sub => {
                if (sub.score !== null && sub.score !== undefined && sub.score !== '') {
                    totalScoreVal += Number(sub.score);
                    gradedCount++;
                }
            });
            const averageScoreVal = gradedCount > 0 ? Math.round((totalScoreVal / gradedCount) * 10) / 10 : 0;

            const sortedStudents = [...AppStore.students].sort((a, b) => {
                const subA = taskSubms.find(sub => sub.student_id === a.id);
                const subB = taskSubms.find(sub => sub.student_id === b.id);
                const statusA = subA ? subA.status : 'Belum Kumpul';
                const statusB = subB ? subB.status : 'Belum Kumpul';
                const isUnfilledA = statusA !== 'Sudah Kumpul';
                const isUnfilledB = statusB !== 'Sudah Kumpul';
                if (isUnfilledA && !isUnfilledB) return -1;
                if (!isUnfilledA && isUnfilledB) return 1;
                return a.name.localeCompare(b.name);
            });

