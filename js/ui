                                    <span class="text-[8px] font-black uppercase px-2 py-0.5 rounded-full ${t.type === 'Misi' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'}">${t.type}</span>
                                    <span class="text-[8px] font-black uppercase px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">${t.category}</span>
                                    ${isAllFinished ? '<span class="text-[8px] bg-sky-100 text-sky-800 px-2 py-0.5 rounded-full font-black uppercase">TUNTAS</span>' : ''}
                                </div>
                                <h5 class="font-black text-xs text-slate-800 truncate" title="${t.title}">${t.title}</h5>
                                <p class="text-[9px] text-gray-500 font-bold mt-0.5"><i class="fa-regular fa-clock mr-0.5"></i> Target: ${t.due_date}</p>
                            </div>
                        </div>
                        <div class="flex gap-1 items-center shrink-0">
                            <button onclick="event.stopPropagation(); toggleLockTask('${t.id}')" class="text-${t.is_locked ? 'red' : 'green'}-500 hover:bg-slate-100 p-2 rounded-xl transition" title="${t.is_locked ? 'Buka Kunci' : 'Kunci Tugas'}"><i class="fa-solid fa-${t.is_locked ? 'lock' : 'lock-open'} text-xs"></i></button>
                            ${t.is_locked ? '' : `<button onclick="event.stopPropagation(); bukaFormEditTugas('${t.id}')" class="text-blue-500 hover:bg-blue-50 p-2 rounded-xl transition"><i class="fa-solid fa-pen text-xs"></i></button>`}
                            ${t.is_locked ? '' : `<button onclick="event.stopPropagation(); hapusTugas('${t.id}')" class="text-red-500 hover:bg-red-50 p-2 rounded-xl transition"><i class="fa-solid fa-trash text-xs"></i></button>`}
                            <span class="w-6 h-6 flex items-center justify-center text-slate-400 bg-slate-50 rounded-lg ml-1"><i class="fa-solid ${isExpanded ? 'fa-chevron-up' : 'fa-chevron-down'} text-[10px]"></i></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="flex justify-between text-[9px] font-black text-gray-500 uppercase mb-1">
                            <span>Kemajuan Belajar: ${completionRate}%</span>
                            <span>${completed}/${totalAssigned} Siswa Kumpul</span>
                        </div>
                        <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
