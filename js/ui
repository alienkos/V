export function renderTabAbsen(container) {
    const today = getTodayDate();
    let selectedDate = document.getElementById('absen-date-picker')?.value || today;
    let todayAttendance = AppStore.attendanceData.find(a => a.date === selectedDate);
    
    if (!todayAttendance) {
        let defaultRecord = {};
        AppStore.students.forEach(s => { defaultRecord[s.id] = 'H'; }); 
        todayAttendance = { date: selectedDate, records: defaultRecord };
    }

    const filledDates = AppStore.attendanceData.map(d => d.date);
    const isCurrentlyFilled = filledDates.includes(selectedDate);

    let html = `
        <div class="p-3 bg-violet-50 rounded-2xl border-2 border-violet-150 space-y-3 mb-4">
            <h5 class="font-black text-xs text-violet-800 uppercase flex items-center gap-1.5">
                <i class="fa-solid fa-calendar-alt text-violet-600"></i> EDIT ABSENSI LALU ATAU HARI INI
            </h5>
            <div class="flex flex-col gap-2">
                <div>
                    <label class="text-[9px] font-black text-gray-500 uppercase tracking-wide block mb-1">Pilih Tanggal Presensi</label>
                    <div class="flex gap-2 items-center">
                        <input type="date" id="absen-date-picker" value="${selectedDate}" onchange="changeAbsenView()" class="flex-1 p-2 text-xs rounded-xl bg-white border border-violet-250 text-gray-850 font-bold">
                        <span class="text-xs font-black px-2 py-1.5 rounded-xl ${isCurrentlyFilled ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                            ${isCurrentlyFilled ? '✓ Terisi' : '✗ Belum Terisi'}
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-2 max-h-56 overflow-y-auto pr-1">
    `;

    AppStore.students.forEach(s => {
        const status = todayAttendance.records[s.id] || 'H';
        html += `
            <div class="p-2 bg-white rounded-xl border border-violet-100 flex justify-between items-center text-xs">
                <span class="font-bold text-gray-800 truncate max-w-[120px]">${s.name}</span>
                <div class="flex gap-1 shrink-0">
                    ${['H','S','I','A'].map(opt => `
                        <button onclick="setAbsenStatus('${s.id}', '${opt}')" id="btn-abs-${s.id}-${opt}" class="w-7 h-7 text-xs font-black rounded-lg transition-all ${status === opt ? getAbsenBtnClass(opt) : 'bg-gray-100 text-gray-400'}">${opt}</button>
                    `).join('')}
                </div>
            </div>
        `;
    });

    html += `
        </div>
        <button onclick="simpanAbsensi()" class="btn-3d w-full bg-violet-600 text-white font-black text-xs rounded-xl border-b-4 border-violet-800 mt-2">SIMPAN KEHADIRAN TANGGAL INI</button>
    `;
    container.innerHTML = html;
}

export function getAbsenBtnClass(opt) {
    if (opt === 'H') return "bg-green-600 text-white";
    if (opt === 'S') return "bg-blue-600 text-white";
    if (opt === 'I') return "bg-yellow-500 text-white";
    if (opt === 'A') return "bg-red-600 text-white animate-pulse";
}

