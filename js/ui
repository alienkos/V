export function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
export function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

export function showPopup(title, message, iconClass = "fa-star", iconColor = "text-yellow-500", bgContainer = "bg-yellow-100") {
    document.getElementById('popup-title').innerText = title;
    document.getElementById('popup-message').innerText = message;
    document.getElementById('popup-icon').className = `fa-solid ${iconClass} text-4xl ${iconColor}`;
    document.getElementById('popup-icon-box').className = `w-20 h-20 rounded-full flex items-center justify-center mx-auto -mt-14 mb-4 border-4 border-white shadow-md ${bgContainer}`;
    openModal('modal-popup');
}

export function showCustomConfirm(title, message) {
    document.getElementById('confirm-title').innerText = title;
    document.getElementById('confirm-message').innerText = message;
    openModal('modal-confirm');
    return new Promise((resolve) => {
        confirmResolve = resolve;
    });
}

export function handleConfirm(val) {
    closeModal('modal-confirm');
    if (confirmResolve) confirmResolve(val);
}

export function showCustomPrompt(title, message) {
    document.getElementById('prompt-title').innerText = title;
    document.getElementById('prompt-message').innerText = message;
    document.getElementById('prompt-input').value = '';
    openModal('modal-prompt');
    return new Promise((resolve) => {
        promptResolve = resolve;
    });
}

export function handlePrompt(submit) {
    closeModal('modal-prompt');
    if (promptResolve) {
        promptResolve(submit ? document.getElementById('prompt-input').value.trim() : null);
    }
}

