                </div>
                <span class="font-black text-sky-600"><i class="fa-solid fa-star"></i> ${s.points_good}</span>
            </div>
        `;
    });

    const plBox = document.getElementById('leaderboard-pelanggaran');
    plBox.innerHTML = '';
    const topBad = [...AppStore.students].filter(s => s.points_bad > 0).sort((a,b) => b.points_bad - a.points_bad).slice(0, 5);
    if (topBad.length === 0) {
        plBox.innerHTML = `<p class="text-center text-[10px] text-gray-400 py-2 font-bold">Semua siswa tertib tanpa poin pelanggaran! 🌈</p>`;
