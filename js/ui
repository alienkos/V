                        </div>
                    </div>

                    ${isExpanded ? `
                        <div class="mt-4 space-y-3 bg-slate-50 p-3 rounded-2xl border border-slate-150 card-pop">
                            <div class="flex justify-between items-center pb-2 border-b border-gray-200">
