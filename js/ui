export function bukaFormTambahSiswa() {
    const box = document.getElementById('form-siswa-box');
    if (box) {
        box.classList.toggle('hidden');
        document.getElementById('in-siswa-id').value = '';
        document.getElementById('in-siswa-name').value = '';
        document.getElementById('in-siswa-good').value = '0';
        document.getElementById('in-siswa-bad').value = '0';
        document.getElementById('in-siswa-photo-data').value = '';
        document.getElementById('in-siswa-photo').value = '';
        document.getElementById('preview-photo').classList.add('hidden');
        document.getElementById('preview-icon').classList.remove('hidden');
    }
}

export function bukaFormEditSiswa(id) {
    const s = AppStore.students.find(x => x.id.toString() === id.toString());
    if (!s) return;
    const box = document.getElementById('form-siswa-box');
    if (box) {
        box.classList.remove('hidden');
        document.getElementById('in-siswa-id').value = s.id;
        document.getElementById('in-siswa-name').value = s.name;
        document.getElementById('in-siswa-gender').value = s.gender;
        document.getElementById('in-siswa-good').value = s.points_good;
        document.getElementById('in-siswa-bad').value = s.points_bad;
        
        document.getElementById('in-siswa-photo').value = ''; 
        const photoDataInput = document.getElementById('in-siswa-photo-data');
        const previewImg = document.getElementById('preview-photo');
        const previewIcon = document.getElementById('preview-icon');
        
        if (s.photo) {
            photoDataInput.value = s.photo;
            previewImg.src = s.photo;
            previewImg.classList.remove('hidden');
            previewIcon.classList.add('hidden');
        } else {
            photoDataInput.value = '';
            previewImg.classList.add('hidden');
            previewIcon.classList.remove('hidden');
        }
    }
}