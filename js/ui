export function searchStudentInPoinForm() {
    const query = document.getElementById('in-poin-student-search').value.toLowerCase().trim();
    const resultsBox = document.getElementById('poin-student-search-results');
    
    if (query.length === 0) {
        resultsBox.innerHTML = '';
        resultsBox.classList.add('hidden');
        return;
    }

    const matched = AppStore.students.filter(s => s.name.toLowerCase().includes(query));
    resultsBox.innerHTML = '';

    if (matched.length === 0) {
        resultsBox.innerHTML = `<div class="p-2 text-xs text-gray-400 text-center">Siswa tidak ditemukan</div>`;
    } else {
        matched.forEach(s => {
            const row = document.createElement('div');
            row.className = "p-2 hover:bg-sky-50 text-xs font-bold text-gray-700 cursor-pointer transition";
            row.innerText = s.name;
            row.onclick = () => {
                document.getElementById('in-poin-student-search').value = s.name;
                document.getElementById('in-poin-student').value = s.id;
                resultsBox.classList.add('hidden');
            };
            resultsBox.appendChild(row);
        });
    }
    resultsBox.classList.remove('hidden');
}

