                                ${t.is_locked ? '<span class="text-[9px] font-black text-red-600 uppercase bg-red-50 px-2 py-1 rounded border border-red-200"><i class="fa-solid fa-lock"></i> Pengeditan Dikunci</span>' : `<button onclick="markAllTaskSubmissionsAsDone('${t.id}')" class="bg-sky-600 hover:bg-sky-500 text-white font-black text-[9px] px-2.5 py-1 rounded-lg border-b-2 border-sky-800 transition active:scale-95 flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> Semua Lulus</button>`}
                            </div>

                            <div class="space-y-1.5 max-h-56 overflow-y-auto divide-y divide-gray-100">
                                ${sortedStudents.map(s => {
                                    const subm = taskSubms.find(sub => sub.student_id === s.id);
                                    const currentStatus = subm ? subm.status : 'Belum Kumpul';
                                    const currentScore = (subm && subm.score !== null && subm.score !== undefined) ? subm.score : '';
                                    
                                    let selectColor = "bg-white text-gray-800 border-gray-200";
                                    if (currentStatus === 'Menunggu Verifikasi') selectColor = "bg-yellow-100 text-yellow-800 border-yellow-300 animate-pulse font-black shadow-inner";
                                    if (currentStatus === 'Sudah Kumpul') selectColor = "bg-green-100 text-green-800 border-green-300 font-bold";
                                    if (currentStatus === 'Remedial') selectColor = "bg-red-100 text-red-800 border-red-300 font-bold";

                                    const scoreStyle = (currentScore !== '' && Number(currentScore) < 70) ? "border-red-400 text-red-600 bg-red-50 font-black" : "border-gray-200 text-gray-800 bg-white font-bold";

                                    return `
                                        <div class="flex justify-between items-center py-2 text-xs gap-2">
                                            <span class="font-bold text-slate-700 truncate flex-1">${s.name}</span>
                                            <div class="flex items-center gap-1.5 shrink-0">
                                                <input type="number" value="${currentScore}" placeholder="Nilai" ${t.is_locked ? 'disabled' : ''} onblur="updateSubmissionScore('${t.id}', '${s.id}', this.value)" class="w-14 p-1.5 text-center text-xs rounded-lg border ${scoreStyle} focus:outline-none focus:border-blue-500">
                                                <select onchange="updateSubmissionStatus('${t.id}', '${s.id}', this.value)" ${t.is_locked ? 'disabled' : ''} class="p-1.5 text-[10px] rounded-lg border font-bold focus:outline-none ${selectColor}">
                                                    <option value="Belum Kumpul" ${currentStatus === 'Belum Kumpul' ? 'selected' : ''}>🔴 Belum</option>
                                                    <option value="Menunggu Verifikasi" ${currentStatus === 'Menunggu Verifikasi' ? 'selected' : ''}>🟡 Verif</option>
                                                    <option value="Sudah Kumpul" ${currentStatus === 'Sudah Kumpul' ? 'selected' : ''}>🟢 Selesai</option>
                                                    <option value="Remedial" ${currentStatus === 'Remedial' ? 'selected' : ''}>⚠️ Remed</option>
                                                </select>
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        </div>
                    ` : ''}

                    <div class="mt-3 pt-3 border-t border-dashed border-gray-150 flex justify-between items-center text-[10px] font-black uppercase text-gray-500">
                        <span>Akumulasi Nilai: <span class="text-blue-600 font-extrabold">${totalScoreVal}</span></span>
                        <span>Rata-Rata Kelas: <span class="px-2 py-0.5 rounded-md ${averageScoreVal < 70 ? 'bg-red-100 text-red-700' : 'bg-sky-100 text-sky-700'}">${averageScoreVal}</span></span>
                    </div>
                </div>
            `;
        });
    }

    html += `
                </div>
            </div>
        </div>
    `;
    container.innerHTML = html;

    if (AppStore.isDesktopMode) {
        const box = document.getElementById('form-tugas-box');
        const list = document.getElementById('tugas-list-area');
        if (box && list) {
            box.classList.remove('hidden');
            list.classList.remove('lg:col-span-12');
            list.classList.add('lg:col-span-7');
        }
    }
}

export function filterTaskTab(filter) {
    playSfx('click');
    AppStore.activeTaskTabFilter = filter;
    renderTabTugas(document.getElementById('admin-panel-content'));
}

export function filterTaskCategory(category) {
    playSfx('click');
    AppStore.activeTaskCategoryFilter = category;
    renderTabTugas(document.getElementById('admin-panel-content'));
}

export function toggleTaskGrading(taskId) {
    AppStore.expandedTaskId = (AppStore.expandedTaskId === taskId) ? null : taskId;
    renderTabTugas(document.getElementById('admin-panel-content'));
}

export function bukaFormTambahTugas() {
    const el = document.getElementById('form-tugas-box');
    const list = document.getElementById('tugas-list-area');
    if (el) {
        if (AppStore.isDesktopMode) {
            el.classList.remove('hidden');
            return;
        }
        
        el.classList.toggle('hidden');
        if (!el.classList.contains('hidden')) {
            document.getElementById('in-tugas-id').value = '';
            document.getElementById('in-tugas-title').value = '';
            document.getElementById('in-tugas-desc').value = '';
            list.classList.add('hidden');
        } else {
            list.classList.remove('hidden');
        }
    }
}

export function batalEditTugasForm() {
    playSfx('click');
    if (AppStore.isDesktopMode) {
        document.getElementById('in-tugas-id').value = '';
        document.getElementById('in-tugas-title').value = '';
        document.getElementById('in-tugas-desc').value = '';
        return;
    }
    
    document.getElementById('form-tugas-box').classList.add('hidden');
    document.getElementById('tugas-list-area').classList.remove('hidden');
}

export function bukaFormEditTugas(id) {
    const t = AppStore.tasks.find(x => x.id === id);
    if (!t) return;
    document.getElementById('form-tugas-box').classList.remove('hidden');
    if (!AppStore.isDesktopMode) {
        document.getElementById('tugas-list-area').classList.add('hidden');
    }
    document.getElementById('in-tugas-id').value = t.id;
    document.getElementById('in-tugas-title').value = t.title;
    document.getElementById('in-tugas-desc').value = t.description;
    document.getElementById('in-tugas-date').value = t.due_date;
    document.getElementById('in-tugas-type').value = t.type;
    document.getElementById('in-tugas-category').value = t.category;
}

export function renderTabRekapNilai(container) {
    let selectedCategory = document.getElementById('rekap-category-filter')?.value || 'PKN';
    const catTasks = AppStore.tasks.filter(t => t.category === selectedCategory);
    const studentAverages = [];

    AppStore.students.forEach(s => {
        let sum = 0;
        let count = 0;
        catTasks.forEach(t => {
            const subm = AppStore.taskSubmissions.find(sub => sub.task_id === t.id && sub.student_id === s.id);
            if (subm && subm.score !== null && subm.score !== undefined && subm.score !== '') {
                sum += Number(subm.score);
                count++;
            }
        });
        const avg = count > 0 ? Math.round((sum / count) * 10) / 10 : 0;
        studentAverages.push({
            id: s.id,
            name: s.name,
            gender: s.gender,
            average: avg,
            tasksGraded: count
        });
    });

    const rankedStudents = [...studentAverages].sort((a,b) => b.average - a.average);

    let html = `
        <div class="flex justify-between items-center mb-3">
            <h4 class="font-black text-xs text-indigo-800 uppercase tracking-wider">Rekap Nilai & Ranking Kategori</h4>
            <select id="rekap-category-filter" onchange="changeRekapCategoryView()" class="p-1 text-[10px] rounded bg-white text-indigo-800 border-2 border-indigo-100 font-black">
                <option value="PKN" ${selectedCategory === 'PKN' ? 'selected' : ''}>PKN</option>
                <option value="BINA" ${selectedCategory === 'BINA' ? 'selected' : ''}>BINA</option>
                <option value="MTK" ${selectedCategory === 'MTK' ? 'selected' : ''}>MTK</option>
                <option value="IPAS" ${selectedCategory === 'IPAS' ? 'selected' : ''}>IPAS</option>
                <option value="SENI" ${selectedCategory === 'SENI' ? 'selected' : ''}>SENI</option>
                <option value="B.ING" ${selectedCategory === 'B.ING' ? 'selected' : ''}>B.ING</option>
                <option value="KKA" ${selectedCategory === 'KKA' ? 'selected' : ''}>KKA</option>
                <option value="LITERASI" ${selectedCategory === 'LITERASI' ? 'selected' : ''}>LITERASI</option>
                <option value="LAINNYA" ${selectedCategory === 'LAINNYA' ? 'selected' : ''}>LAINNYA</option>
            </select>
        </div>

        <div class="space-y-3">
            <div class="overflow-x-auto bg-white rounded-2xl border-2 border-indigo-100 p-2 shadow-sm">
                <table class="w-full text-xs text-left text-gray-700 font-semibold border-collapse">
                    <thead>
                        <tr class="bg-indigo-50 text-indigo-800 uppercase text-[9px] font-black border-b border-indigo-100">
                            <th class="p-2 text-center w-12">Peringkat</th>
                            <th class="p-2">Nama Siswa</th>
                            <th class="p-2 text-center">Tugas Dinilai</th>
                            <th class="p-2 text-center">Nilai Rerata</th>
                        </tr>
                    </thead>
                    <tbody>
    `;

    rankedStudents.forEach((student, idx) => {
        let medalHtml = `${idx + 1}`;
        if (idx === 0) medalHtml = '🥇';
        if (idx === 1) medalHtml = '🥈';
        if (idx === 2) medalHtml = '🥉';

        const highlightColor = student.average < 70 ? "text-red-600 font-extrabold" : "text-green-600 font-extrabold";

        html += `
            <tr class="hover:bg-indigo-50/30 border-b border-gray-100">
                <td class="p-2 text-center font-black text-xs">${medalHtml}</td>
                <td class="p-2">
                    <div class="font-bold text-gray-800">${student.name}</div>
                    <div class="text-[8px] text-gray-400 font-extrabold uppercase">${student.gender}</div>
                </td>
                <td class="p-2 text-center font-bold text-gray-600">${student.tasksGraded} Tugas</td>
                <td class="p-2 text-center text-sm ${highlightColor}">${student.average}</td>
            </tr>
        `;
    });

    html += `
                    </tbody>
                </table>
            </div>
        </div>
    `;

    container.innerHTML = html;
}

