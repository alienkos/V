export function applyPresetPoin() {
    const type = document.getElementById('in-poin-type').value;
    const presetId = document.getElementById('in-poin-preset').value;
    if (!presetId) return;

    let preset;
    if (type === 'Kebaikan') {
        preset = AppStore.goodPresets.find(p => p.id === presetId);
    } else {
        preset = AppStore.violationPresets.find(p => p.id === presetId);
    }

    if (preset) {
        document.getElementById('in-poin-num').value = preset.default_points;
        document.getElementById('in-poin-desc').value = preset.title;
    }
}

