export function getStudentAttendanceStats(studentId) {
    let totalDays = AppStore.attendanceData.length;
    let hadir = 0;
    let sakit = 0;
    let izin = 0;
    let alfa = 0;

    AppStore.attendanceData.forEach(day => {
        const status = day.records[studentId] || 'H'; 
        if (status === 'H') hadir++;
        else if (status === 'S') sakit++;
        else if (status === 'I') izin++;
        else if (status === 'A') alfa++;
    });

    const totalMarked = hadir + sakit + izin + alfa;
    const presencePercent = totalMarked > 0 ? Math.round((hadir / totalMarked) * 100) : 100;

    return { totalDays, hadir, sakit, izin, alfa, percent: presencePercent, totalMarked };
}

export function getStudentRpgTitle(s) {
    const att = getStudentAttendanceStats(s.id);
    const xp = (s.points_good * 12) + (att.hadir * 4) - (s.points_bad * 18);
    
    let title = "Petualang Pemula 🎒";
    let colorClass = "bg-slate-100 text-slate-800";
    if (xp < 0) {
        title = "Pendekar Tobat 🛡️";
        colorClass = "bg-amber-100 text-amber-800";
    } else if (xp >= 100 && xp < 300) {
        title = "Ksatria Disiplin ⚔️";
        colorClass = "bg-indigo-100 text-indigo-800";
    } else if (xp >= 300 && xp < 600) {
        title = "Pahlawan Teladan 🌟";
        colorClass = "bg-sky-100 text-sky-800";
    } else if (xp >= 600) {
        title = "Bintang Legendaris 👑";
        colorClass = "bg-yellow-150 text-yellow-800 font-extrabold animate-pulse border border-yellow-300";
    }
    return { title, colorClass, xpValue: xp };
}

export function getStudentSubjectInsights(studentId) {
    const categories = ['PKN', 'BINA', 'MTK', 'IPAS', 'SENI', 'B.ING', 'KKA', 'LITERASI', 'LAINNYA'];
    const categoryGrades = {};
    
    categories.forEach(cat => {
        categoryGrades[cat] = { sum: 0, count: 0 };
    });
    
    AppStore.tasks.forEach(t => {
        const subm = AppStore.taskSubmissions.find(s => s.task_id === t.id && s.student_id === studentId);
        if (subm && subm.score !== null && subm.score !== undefined && subm.score !== '') {
            const cat = t.category || 'LAINNYA';
            if (categoryGrades[cat]) {
                categoryGrades[cat].sum += Number(subm.score);
                categoryGrades[cat].count += 1;
            }
        }
    });
    
    let bestSubject = null;
    let worstSubject = null;
    let bestAvg = -1;
    let worstAvg = 101;
    let hasGrades = false;
    
    categories.forEach(cat => {
        const data = categoryGrades[cat];
        if (data.count > 0) {
            hasGrades = true;
            const avg = data.sum / data.count;
            if (avg > bestAvg) {
                bestAvg = avg;
                bestSubject = cat;
            }
            if (avg < worstAvg) {
                worstAvg = avg;
                worstSubject = cat;
            }
        }
    });
    
    if (!hasGrades) return null;
    
    bestAvg = Math.round(bestAvg * 10) / 10;
    worstAvg = Math.round(worstAvg * 10) / 10;
    
    if (bestSubject === worstSubject) { worstSubject = null; }
    
    return {
        best: { name: bestSubject, avg: bestAvg },
        worst: worstSubject ? { name: worstSubject, avg: worstAvg } : null
    };
}

export function updateClassAnalytics() {
    if (AppStore.attendanceData.length === 0) {
        document.getElementById('class-monthly-presence-rate').innerText = "100% Bulan Ini";
    } else {
        let totalHadirCount = 0;
        let totalRecordCount = 0;
        
        AppStore.attendanceData.forEach(day => {
            Object.values(day.records).forEach(status => {
                if (status === 'H') totalHadirCount++;
                totalRecordCount++;
            });
        });
        
        const avgPercent = totalRecordCount > 0 ? Math.round((totalHadirCount / totalRecordCount) * 100) : 100;
        document.getElementById('class-monthly-presence-rate').innerText = `${avgPercent}% Bulan Ini`;
    }

    const totalSubmCount = AppStore.taskSubmissions.length;
    const completedSubmCount = AppStore.taskSubmissions.filter(s => s.status === 'Sudah Kumpul').length;
    const tasksPercent = totalSubmCount > 0 ? Math.round((completedSubmCount / totalSubmCount) * 100) : 0;
    document.getElementById('class-monthly-tasks-rate').innerText = `${tasksPercent}% Selesai`;
}

