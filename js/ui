export function renderStudentMisiList() {
    const misiContainer = document.getElementById('student-misi-list');
    misiContainer.innerHTML = '';

    const allMisi = AppStore.tasks.filter(t => t.type === 'Misi');
    if (allMisi.length === 0) {
        misiContainer.innerHTML = `<p class="text-xs text-gray-400 text-center py-4 font-bold">Belum ada misi karakter aktif.</p>`;
        document.getElementById('student-misi-progress').innerText = "0% Tuntas";
        return;
    }

    const groupedMisi = {};
    allMisi.forEach(m => {
        const cat = m.category || 'MISI_KARAKTER';
        if (!groupedMisi[cat]) groupedMisi[cat] = [];
        groupedMisi[cat].push(m);
    });

    let completedMisiCount = 0;

    Object.keys(groupedMisi).forEach(cat => {
        misiContainer.innerHTML += `
            <div class="text-[10px] font-black text-orange-600 uppercase tracking-widest mt-2 mb-1 border-b border-orange-100 pb-0.5">
                📂 Kategori: ${cat}
            </div>
        `;

        groupedMisi[cat].forEach(m => {
            const subm = AppStore.taskSubmissions.find(s => s.task_id === m.id && s.student_id === AppStore.currentStudent.id);
            const status = subm ? subm.status : 'Belum Kumpul';

            if (status === 'Sudah Kumpul') completedMisiCount++;

            let badgeColor = "bg-gray-100 text-gray-600 border border-gray-300";
            let actionButtonHtml = '';

            if (status === "Sudah Kumpul") {
                badgeColor = "bg-green-100 text-green-800 border border-green-300";
            } else if (status === "Menunggu Verifikasi") {
                badgeColor = "bg-yellow-100 text-yellow-800 border border-yellow-300 animate-pulse";
            } else if (status === "Remedial") {
                badgeColor = "bg-red-100 text-red-800 border border-red-300";
                actionButtonHtml = `<button onclick="laporTugasSelesai('${m.id}')" class="mt-2 w-full py-1.5 bg-yellow-400 text-amber-950 font-black rounded-lg text-[10px] btn-3d border-b-2 border-yellow-600">REMEDIAL SELESAI? LAPOR SEKARANG! 🚀</button>`;
            } else {
                actionButtonHtml = `<button onclick="laporTugasSelesai('${m.id}')" class="mt-2 w-full py-1.5 bg-orange-500 text-white font-black rounded-lg text-[10px] btn-3d border-b-2 border-orange-700">MULAI SELESAIKAN MISI! ⚔️</button>`;
            }

            if (m.is_locked) {
                actionButtonHtml = `<span class="mt-2 flex items-center justify-center gap-1.5 w-full py-2 bg-red-50 text-red-600 font-black rounded-lg text-[10px] border border-red-200"><i class="fa-solid fa-lock"></i> Misi Terkunci</span>`;
            }

            misiContainer.innerHTML += `
                <div class="p-3 bg-orange-50/50 border border-orange-100 rounded-2xl mb-2">
                    <div class="flex justify-between items-start gap-2">
                        <div>
                            <h5 class="font-black text-xs text-gray-800">${m.title}</h5>
                            <p class="text-[9px] text-gray-500 mt-0.5">${m.description}</p>
                            <span class="text-[8px] text-gray-400 mt-1 inline-block">Batas: ${m.due_date}</span>
                        </div>
                        <span class="text-[9px] font-black px-2 py-1 rounded-xl uppercase shrink-0 ${badgeColor}">${status}</span>
                    </div>
                    ${actionButtonHtml}
                </div>
            `;
        });
    });

    const percent = Math.round((completedMisiCount / allMisi.length) * 100);
    document.getElementById('student-misi-progress').innerText = `${percent}% Tuntas`;
}

export function renderStudentTugasList() {
    const tugasContainer = document.getElementById('student-tasks-list');
    tugasContainer.innerHTML = '';

    const allTugas = AppStore.tasks.filter(t => t.type === 'Tugas');
    if (allTugas.length === 0) {
        tugasContainer.innerHTML = `<p class="text-xs text-gray-400 text-center py-4 font-bold">Belum ada tugas akademik aktif.</p>`;
        document.getElementById('student-tugas-progress').innerText = "0% Tuntas";
        document.getElementById('display-std-academic-total-pct').innerText = "0%";
        return;
    }

    const groupedTugas = {};
    allTugas.forEach(t => {
        const cat = t.category || 'LAINNYA';
        if (!groupedTugas[cat]) groupedTugas[cat] = [];
        groupedTugas[cat].push(t);
    });

    let completedTugasCount = 0;

    Object.keys(groupedTugas).forEach(cat => {
        tugasContainer.innerHTML += `
            <div class="text-[10px] font-black text-blue-600 uppercase tracking-widest mt-2 mb-1 border-b border-blue-100 pb-0.5">
                📂 Mata Pelajaran: ${cat}
            </div>
        `;

        groupedTugas[cat].forEach(t => {
            const subm = AppStore.taskSubmissions.find(s => s.task_id === t.id && s.student_id === AppStore.currentStudent.id);
            const status = subm ? subm.status : 'Belum Kumpul';
            const currentScore = subm && subm.score !== null ? subm.score : '';

            if (status === 'Sudah Kumpul') completedTugasCount++;

            let badgeColor = "bg-gray-100 text-gray-600 border border-gray-300";
            let inputScoreHtml = '';

            if (status === "Sudah Kumpul") {
                badgeColor = "bg-green-100 text-green-800 border border-green-300";
                inputScoreHtml = `<span class="text-xs font-black text-green-700 bg-green-50 px-2 py-1.5 rounded-xl border border-green-200">Selesai (Nilai: ${currentScore})</span>`;
            } else {
                if (status === "Menunggu Verifikasi") {
                    badgeColor = "bg-yellow-100 text-yellow-800 border border-yellow-300 animate-pulse";
                } else if (status === "Remedial") {
                    badgeColor = "bg-red-100 text-red-800 border border-red-300";
                }
                inputScoreHtml = `
                    <div class="mt-2.5 flex items-center gap-1.5 bg-white p-2 border border-blue-200 rounded-xl">
                        <span class="text-[9px] font-black text-gray-400 uppercase">Input Nilaimu:</span>
                        <input type="number" id="std-score-input-${t.id}" value="${currentScore}" placeholder="Cth: 85" class="w-14 p-1 text-center text-xs font-black border border-gray-300 rounded focus:outline-none focus:border-blue-500">
                        <button onclick="laporTugasDenganNilaiSiswa('${t.id}')" class="bg-blue-600 hover:bg-blue-700 text-white font-black text-[9px] px-2.5 py-1.5 rounded-lg border-b-2 border-blue-800 uppercase">Kumpul</button>
                    </div>
                `;
            }

            if (t.is_locked) {
                inputScoreHtml = `<span class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-black text-red-700 bg-red-50 px-3 py-1.5 rounded-xl border border-red-200"><i class="fa-solid fa-lock"></i> Terkunci (Nilai: ${currentScore !== '' ? currentScore : '-'})</span>`;
            }

            tugasContainer.innerHTML += `
                <div class="p-3 bg-blue-50/50 border border-blue-100 rounded-2xl mb-2">
                    <div class="flex justify-between items-start gap-2">
                        <div class="flex-1">
                            <h5 class="font-black text-xs text-gray-800">${t.title}</h5>
                            <p class="text-[9px] text-gray-500 mt-0.5">${t.description}</p>
                            <span class="text-[8px] text-gray-400 mt-1 inline-block">Batas: ${t.due_date}</span>
                        </div>
                        <span class="text-[9px] font-black px-2 py-1 rounded-xl uppercase shrink-0 ${badgeColor}">${status}</span>
                    </div>
                    <div class="mt-2 text-right">
                        ${inputScoreHtml}
                    </div>
                </div>
            `;
        });
    });

    const percent = Math.round((completedTugasCount / allTugas.length) * 100);
    document.getElementById('student-tugas-progress').innerText = `${percent}% Tuntas`;
    document.getElementById('display-std-academic-total-pct').innerText = `${percent}%`;
}

export function renderDashboardStats() {
